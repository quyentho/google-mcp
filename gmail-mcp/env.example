# Copy to .env — NEVER commit .env, token.json, or credentials.json
GMAIL_USER=you@gmail.com
GMAIL_SENDER_NAME=Matthew

# Auth method: auto | app_password | oauth
# auto = use App Password if set, otherwise OAuth token if present
GMAIL_AUTH_METHOD=auto

# --- Option 1: App Password (SMTP send + IMAP read) ---
# Google Account > Security > 2-Step Verification ON > App passwords > Mail
# Also enable IMAP: Gmail Settings > Forwarding and POP/IMAP > Enable IMAP
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# --- Option 2: OAuth 2.0 (Gmail API, send + read) ---
# Google Cloud > Gmail API enabled > Desktop OAuth client > credentials.json
# Then run once: python auth_oauth.py  (creates token.json, scopes gmail.send + gmail.readonly)
# Delete an old token.json first if it only had gmail.send.
# GMAIL_CREDENTIALS_FILE=credentials.json
# GMAIL_TOKEN_FILE=token.json

# Optional, defaults shown:
# GMAIL_SMTP_HOST=smtp.gmail.com
# GMAIL_SMTP_PORT=587
# GMAIL_IMAP_HOST=imap.gmail.com
# GMAIL_IMAP_PORT=993
