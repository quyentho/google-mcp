# Copy to .env — NEVER commit .env, token.json, credentials.json, or service-account.json
# Calendar has NO App Password mode — Google requires OAuth or a Service Account.

# Auth method: auto | oauth | service_account
# auto = use Service Account if service-account.json exists, otherwise OAuth token if present
CALENDAR_AUTH_METHOD=auto

# Default timezone for times without an offset (change to yours)
CALENDAR_TIMEZONE=Asia/Saigon

# --- Option 1: OAuth 2.0 (your own Google account) ---
# Google Cloud > Calendar API enabled > Desktop OAuth client > credentials.json
# Then run once: python auth_oauth.py  (creates token.json, scope calendar)
# CALENDAR_CREDENTIALS_FILE=credentials.json
# CALENDAR_TOKEN_FILE=token.json

# --- Option 2: Service Account (automation / shared calendars) ---
# Google Cloud > Service Accounts > create one > Keys > Add key (JSON) > save as service-account.json
# Share the calendar with the service account's client_email
# ("Make changes to events"). Use that calendar's id, not "primary".
# CALENDAR_SERVICE_ACCOUNT_FILE=service-account.json
