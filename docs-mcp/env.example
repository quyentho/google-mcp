# Copy to .env — NEVER commit .env, token.json, credentials.json, or service-account.json
# Docs has NO App Password mode — Google requires OAuth or a Service Account.

# Auth method: auto | oauth | service_account
# auto = use Service Account if service-account.json exists, otherwise OAuth token if present
DOCS_AUTH_METHOD=auto

# --- Option 1: OAuth 2.0 (your own Google account) ---
# Google Cloud > Docs API + Drive API enabled > Desktop OAuth client > credentials.json
# Then run once: python auth_oauth.py  (creates token.json, scopes documents + drive.readonly)
# DOCS_CREDENTIALS_FILE=credentials.json
# DOCS_TOKEN_FILE=token.json

# --- Option 2: Service Account (automation / shared documents) ---
# Google Cloud > Service Accounts > create one > Keys > Add key (JSON) > save as service-account.json
# Share each document with the service account's client_email (Viewer or Editor).
# DOCS_SERVICE_ACCOUNT_FILE=service-account.json
