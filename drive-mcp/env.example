# Copy to .env — NEVER commit .env, token.json, credentials.json, or service-account.json
# Drive has NO App Password mode — Google requires OAuth or a Service Account.

# Auth method: auto | oauth | service_account
# auto = use Service Account if service-account.json exists, otherwise OAuth token if present
DRIVE_AUTH_METHOD=auto

# --- Option 1: OAuth 2.0 (your own Google account) ---
# Google Cloud > Drive API enabled > Desktop OAuth client > credentials.json
# Then run once: python auth_oauth.py  (creates token.json, scope drive)
# DRIVE_CREDENTIALS_FILE=credentials.json
# DRIVE_TOKEN_FILE=token.json

# --- Option 2: Service Account (automation / shared folders) ---
# Google Cloud > Service Accounts > create one > Keys > Add key (JSON) > save as service-account.json
# Share the folder/file with the service account's client_email (Viewer or Editor).
# DRIVE_SERVICE_ACCOUNT_FILE=service-account.json
