# Copy to .env — NEVER commit .env, token.json, credentials.json, or service-account.json
# Apps Script has NO App Password mode — Google requires OAuth or a Service Account.

# Auth method: auto | oauth | service_account
# auto = use Service Account if service-account.json exists, otherwise OAuth token if present
APPSCRIPT_AUTH_METHOD=auto

# --- Option 1: OAuth 2.0 (your own Google account) ---
# Google Cloud > Apps Script API + Drive API enabled > Desktop OAuth client > credentials.json
# Then run once: python auth_oauth.py  (creates token.json, scopes script.projects + script.deployments + drive.readonly)
# APPSCRIPT_CREDENTIALS_FILE=credentials.json
# APPSCRIPT_TOKEN_FILE=token.json

# --- Option 2: Service Account (automation / shared projects) ---
# Google Cloud > Service Accounts > create one > Keys > Add key (JSON) > save as service-account.json
# Share each script project with the service account's client_email (Editor).
# APPSCRIPT_SERVICE_ACCOUNT_FILE=service-account.json
